#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Arabidopsis_thaliana'
[2] 'Oryza_sativa'
[3] 'Zea_mays'
[4] 'Triticum_aestivum'
[5] 'Brassica_rapa'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=9;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	8	 2 3,
	100	 4,
	100	 1 5,
	100	 5,
	100	 1,
	80	 3 4,
	13	 2 4,
;
END; [Splits]

